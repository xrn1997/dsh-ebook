{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "strict": true, "skipLibCheck": true, "noEmit": true,
    "types": ["node"], "esModuleInterop": true,
    "jsx": "react-jsx", "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "paths": { "@engine/*": ["./src/engine/*"] }
  },
  "include": ["src", "tests"]
}
